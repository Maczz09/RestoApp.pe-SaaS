# Scripts que se ejecutan dentro de contenedores Linux (Docker) deben
# mantener terminadores de línea LF sin importar el sistema operativo donde
# se clone el repo. En Windows, sin esta regla, `core.autocrlf=true`
# convierte estos archivos a CRLF en el checkout y rompe el shebang dentro
# del contenedor (exec: no such file or directory).
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
entrypoint* text eol=lf
apps/pwa-cliente/public/brand/*.png filter=lfs diff=lfs merge=lfs -text
apps/pwa-cliente/src/assets/brand/*.png filter=lfs diff=lfs merge=lfs -text
docs/*.docx filter=lfs diff=lfs merge=lfs -text
