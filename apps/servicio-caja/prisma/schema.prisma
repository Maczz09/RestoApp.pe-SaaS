generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaccion {
  id            String   @id @default(uuid())
  tenantId      String?
  cuentaId      String
  sedeId        String
  turnoId       String?
  mesaId        String?
  monto         Decimal  @db.Decimal(10, 2)
  descuento     Decimal  @default(0) @db.Decimal(10, 2)
  metodo        String   // EFECTIVO, TARJETA, etc.
  referencia    String?
  notas         String?
  usuarioId     String?
  cajeroNombre  String?
  // Mesero dominante de la cuenta al momento del pago (auditoría: quién
  // atendió vs. quién cobró). Denormalizado desde servicio-cuentas.
  meseroId      String?
  meseroNombre  String?
  // Número de mesa legible (y hermanas si estaba unida) al momento del
  // cobro — evita mostrar el mesaId (UUID) crudo en la auditoría de caja.
  mesaNumero    String?
  mesaUnidaCon  String?
  // Tipo de comprobante elegido por el cajero al cobrar: BOLETA pide DNI del
  // cliente, FACTURA pide RUC. clienteDocumento queda vacío si el cliente no
  // lo da (dato informativo, este documento no es el comprobante electrónico
  // SUNAT — ver BoletaInterna.tsx).
  tipoComprobante   String   @default("BOLETA")
  clienteDocumento  String?
  // Código legible de la atención ("A0000001"), denormalizado desde la
  // cuenta remota al momento del cobro. Ausente en transacciones de
  // cuentas anteriores a este campo.
  cuentaCorrelativo String?
  divisionParteId String?
  divisionParte DivisionParte? @relation(fields: [divisionParteId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  turno       TurnoCaja? @relation(fields: [turnoId], references: [id])

  @@index([tenantId])
  @@index([cuentaId])
  @@index([turnoId])
  @@index([usuarioId])
  @@index([sedeId, createdAt])
  @@index([tenantId, sedeId, createdAt])
  @@index([cuentaCorrelativo])
  @@map("transacciones")
}

model DivisionCuenta {
  id String @id @default(uuid())
  cuentaId String @unique
  tenantId String
  sedeId String
  version Int @default(1)
  modo String
  config Json
  unidades Json
  totalCentimos Int
  descuentoCentimos Int
  propinaCentimos Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partes DivisionParte[]
  @@index([tenantId, sedeId])
  @@map("division_cuentas")
}

model DivisionParte {
  id String @id @default(uuid())
  divisionId String
  division DivisionCuenta @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  indice Int
  label String
  montoCentimos Int
  propinaCentimos Int
  unidades Json
  items Json
  pagada Boolean @default(false)
  transaccionIds Json @default("[]")
  pagadaAt DateTime?
  transacciones Transaccion[]
  @@unique([divisionId, indice])
  @@map("division_partes")
}

model OutboxEvent {
  id         String   @id @default(uuid())
  tenantId   String?
  routingKey String
  payload    String
  status     String   @default("PENDING") // PENDING, PROCESSED, FAILED
  attempts   Int      @default(0)
  claimedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([tenantId, status])
  @@map("outbox_events")
}

// Idempotencia HTTP (plan 1.3): persiste la Idempotency-Key y la respuesta para
// hacer *replay* en reintentos de POST /caja/pagos (evita pagos duplicados).
model IdempotencyKey {
  id          String    @id @default(uuid())
  tenantId    String?
  key         String    @unique
  method      String?
  path        String?
  statusCode  Int?
  body        String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  // T-14: huella SHA-256 del cuerpo de la petición; misma clave + body distinto → 422.
  requestHash String?

  @@index([tenantId])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model CierreCaja {
  id           String   @id @default(uuid())
  tenantId     String?
  turnoId      String?  @unique
  montoEsperado Decimal  @db.Decimal(10, 2)
  montoReal     Decimal  @db.Decimal(10, 2)
  diferencia    Decimal  @db.Decimal(10, 2)
  usuarioId     String
  resumen       Json?
  createdAt     DateTime @default(now())

  turno         TurnoCaja? @relation(fields: [turnoId], references: [id])

  @@index([tenantId])
  @@map("cierres_caja")
}

model CuentaAbierta {
  cuentaId String   @id
  tenantId String?
  mesaId   String
  sedeId   String
  total    Decimal  @db.Decimal(10, 2)
  estado   String

  @@index([tenantId])
  @@map("cuentas_abiertas")
}

// Cola de cobros intentados con la caja cerrada (sin turno abierto en la
// sede): en vez de rechazar el pago, se guarda tal cual el comando que el
// cajero ya llenó y se reintenta automáticamente en cuanto abre el próximo
// turno de esa sede (abrirTurno → procesarPagosPendientes), preservando la
// cuenta/mesa/hora originales del intento.
model PagoPendiente {
  tenantId String?
  id            String    @id @default(uuid())
  sedeId        String
  cuentaId      String
  montoRecibido Decimal   @db.Decimal(10, 2)
  metodo        String
  descuento     Decimal?  @db.Decimal(10, 2)
  propina       Decimal?  @db.Decimal(10, 2)
  mesaNumero    String?
  mesaUnidaCon  String?
  referencia    String?
  notas         String?
  tipoComprobante   String?
  clienteDocumento  String?
  usuarioId     String?
  cajeroNombre  String?
  // PENDIENTE → PROCESANDO (reclamado por un abrirTurno en curso) →
  // PROCESADO | FALLIDO. PROCESANDO existe para que dos aperturas
  // concurrentes de la misma sede no reintenten la misma fila dos veces.
  estado        String    @default("PENDIENTE")
  transaccionId String?
  error         String?
  createdAt     DateTime  @default(now())
  procesadoAt   DateTime?

  @@index([sedeId, estado])
  @@map("pagos_pendientes")
}

model TurnoCaja {
  id            String   @id @default(uuid())
  tenantId      String?
  sedeId        String
  cajaId        String
  cajaNombre    String
  usuarioId     String
  cajeroNombre  String?
  fondoInicial  Decimal  @db.Decimal(10, 2)
  estado        String
  abiertoAt     DateTime @default(now())
  cerradoAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transacciones Transaccion[]
  movimientos   MovimientoCaja[]
  arqueos       ArqueoCaja[]
  cierre        CierreCaja?

  @@index([tenantId])
  @@index([estado, abiertoAt])
  @@index([usuarioId, estado])
  @@index([sedeId, estado])
  @@index([tenantId, sedeId, estado])
  @@map("turnos_caja")
}

model MovimientoCaja {
  id            String   @id @default(uuid())
  tenantId      String?
  turnoId       String
  tipo          String
  cuentaId      String?
  transaccionId String?
  mesaId        String?
  donde         String
  metodo        String
  monto         Decimal  @db.Decimal(10, 2)
  descuento     Decimal  @default(0) @db.Decimal(10, 2)
  propina       Decimal  @default(0) @db.Decimal(10, 2)
  motivo        String?
  // Código legible de la atención ("A0000001"), denormalizado desde la
  // Transaccion asociada (solo tipo VENTA la trae) — para poder buscar un
  // movimiento del turno por el código sin hacer join.
  cuentaCorrelativo String?
  createdAt     DateTime @default(now())

  turno         TurnoCaja @relation(fields: [turnoId], references: [id])

  @@index([tenantId])
  @@index([turnoId, createdAt])
  @@index([cuentaId])
  @@unique([transaccionId])
  @@map("movimientos_caja")
}

model ArqueoCaja {
  id               String   @id @default(uuid())
  tenantId         String?
  turnoId          String
  denominaciones   Json
  efectivoEsperado Decimal  @db.Decimal(10, 2)
  efectivoContado  Decimal  @db.Decimal(10, 2)
  diferencia       Decimal  @db.Decimal(10, 2)
  usuarioId        String
  createdAt        DateTime @default(now())

  turno            TurnoCaja @relation(fields: [turnoId], references: [id])

  @@index([tenantId])
  @@index([turnoId, createdAt])
  @@map("arqueos_caja")
}

model DocumentoCobro {
  id             String   @id @default(uuid())
  tenantId       String
  sedeId         String
  cuentaId       String
  mesaId         String
  tipo           String
  correlativo    Int?
  total          Decimal  @db.Decimal(10, 2)
  items          Json
  medios         Json
  transaccionIds String[]
  createdAt      DateTime @default(now())

  @@unique([tenantId, sedeId, correlativo])
  @@index([tenantId, sedeId, cuentaId])
  @@map("documentos_cobro")
}

model SerieTicketInterno {
  tenantId    String
  sedeId      String
  correlativo Int

  @@id([tenantId, sedeId])
  @@map("series_ticket_interno")
}

model CajaFusion {
  id String @id
  tenantId String
  sedeId String
  maestraCuentaId String
  cuentaIds Json
  estado String @default("PREPARADA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("caja_fusiones")
}
model CajaFusionReserva {
  cuentaId String @id
  fusionId String
  @@index([fusionId])
  @@map("caja_fusion_reservas")
}
model CajaFusionAlias {
  cuentaId String @id
  maestraCuentaId String
  fusionId String
  @@index([maestraCuentaId])
  @@map("caja_fusion_alias")
}
