generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MesaEstado {
  LIBRE
  OCUPADA
  RESERVADA
}

model Mesa {
  id             String     @id @default(uuid())
  tenantId       String?
  numero         Int
  sedeId         String
  capacidad      Int
  ubicacionId    String
  ubicacion      Ubicacion  @relation(fields: [ubicacionId], references: [id])
  estado         MesaEstado @default(LIBRE)
  cuentaAsociada String?
  grupoId        String?
  grupo          Mesa?      @relation("GrupoMesas", fields: [grupoId], references: [id])
  mesasDelGrupo  Mesa[]     @relation("GrupoMesas")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([tenantId, sedeId, numero])
  @@index([estado])
  @@index([ubicacionId])
  @@index([grupoId])
  @@index([sedeId])
  @@index([tenantId])
  @@map("mesas")
}

model Ubicacion {
  id        String   @id @default(uuid())
  tenantId  String?
  nombre    String
  sedeId    String
  mesas     Mesa[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sedeId, nombre])
  @@index([sedeId])
  @@index([tenantId])
  @@map("ubicaciones")
}

model OutboxEvent {
  id         String    @id @default(uuid())
  tenantId   String?
  routingKey String
  payload    String
  status     String    @default("PENDING")
  attempts   Int       @default(0)
  claimedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("outbox_events")
}

model IdempotencyKey {
  key       String   @id
  tenantId  String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("idempotency_keys")
}
