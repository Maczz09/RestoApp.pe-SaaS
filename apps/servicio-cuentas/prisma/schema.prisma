generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CuentaEstado {
  ABIERTA
  CERRADA
  PAGADA
}

model Cuenta {
  id        String       @id @default(uuid())
  tenantId  String?
  mesaId    String
  sedeId    String
  pedidos   Json
  total     Decimal      @default(0) @db.Decimal(10, 2)
  estado    CuentaEstado @default(ABIERTA)
  ticket    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tenantId])
  @@index([mesaId, estado])
  @@index([sedeId])
  @@map("cuentas")
}

model OutboxEvent {
  id         String    @id @default(uuid())
  tenantId   String?
  routingKey String
  payload    String
  status     String    @default("PENDING") // PENDING, PROCESSED, FAILED
  attempts   Int       @default(0)
  claimedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("outbox_events")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  tenantId  String?
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("idempotency_keys")
}
